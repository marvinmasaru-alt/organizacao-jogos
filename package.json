{
  "name": "sistema-alocacao-funcionarios",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo do Sistema de Alocação de Funcionários (frontend Angular + backend NestJS).",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "overrides": {
    "rxjs": "^7.8.0"
  },
  "scripts": {
    "backend:dev": "npm run start:dev --workspace=backend",
    "backend:build": "npm run build --workspace=backend",
    "frontend:dev": "npm run start --workspace=frontend",
    "frontend:build": "npm run build --workspace=frontend"
  }
}
