// Espelha docs/SQL/create.sql. Nomes de tabela/coluna continuam snake_case
// no Postgres (via @@map/@map); os campos do Prisma Client ficam camelCase,
// mesma convenção que os antigos *.entity.ts já usavam.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoUsuario {
  ADMIN
  RESPONSAVEL

  @@map("tipo_usuario")
}

enum StatusFuncionario {
  PENDENTE
  APROVADO
  BLOQUEADO
  INATIVO

  @@map("status_funcionario")
}

enum TipoSede {
  HUB
  EXTERNA

  @@map("tipo_sede")
}

enum TipoModeloVaga {
  FIXA
  ESPORADICA

  @@map("tipo_modelo_vaga")
}

enum StatusVaga {
  ABERTA
  INCOMPLETA
  COMPLETA
  CANCELADA

  @@map("status_vaga")
}

enum StatusAlocacao {
  ATIVA
  CANCELADA

  @@map("status_alocacao")
}

enum StatusConfirmacao {
  PENDENTE
  PRESENTE
  FALTOU
  CANCELOU
  SUBSTITUICAO_NECESSARIA
  /// Trabalhou cobrindo uma vaga que estava com SUBSTITUICAO_NECESSARIA —
  /// conta como trabalho normal (elegível a pagamento, igual PRESENTE),
  /// mas fica marcado à parte pra abater da contagem de substituições
  /// urgentes daquele tipo (ver ConfirmacoesService.resumoDaSede) e pra
  /// aparecer com rótulo próprio na tela, distinto de um "Trabalhou" comum.
  SUBSTITUIU

  @@map("status_confirmacao")
}

enum StatusPagamento {
  PENDENTE
  PAGO
  CANCELADO

  @@map("status_pagamento")
}

/// Status de recebimento da comissão — independente do StatusPagamento do
/// funcionário (decisão do usuário: pagar o funcionário e receber a
/// comissão são dois eventos financeiros distintos, um não implica o
/// outro). Cada perna (sede/fornecimento) tem o seu, porque pode ser gente
/// diferente recebendo em momentos diferentes.
enum StatusComissao {
  PENDENTE
  RECEBIDA
  CANCELADA

  @@map("status_comissao")
}

/// Tipo de trabalho dinâmico (decisão revertida: não é mais um enum fixo
/// MANPOWER/FORKLIFT) — cadastrado/editado só por Administrador
/// (TiposTrabalhoModule). `ativo=false` tira o tipo dos formulários novos
/// sem apagar nada (princípio geral de histórico) — vaga_tipos/alocacoes/
/// tabela_valores/modelo_vaga_tipos que já usam esse tipo continuam
/// mostrando o nome normalmente.
model TipoTrabalho {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome       String    @unique @db.VarChar(50)
  ativo      Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")

  modeloVagaTipos ModeloVagaTipo[]
  vagaTipos       VagaTipo[]
  alocacoes       Alocacao[]
  tabelaValores   TabelaValor[]

  @@map("tipos_trabalho")
}

model Usuario {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome       String      @db.VarChar(255)
  email      String      @unique @db.VarChar(255)
  senhaHash  String      @map("senha_hash")
  tipo       TipoUsuario
  ativo      Boolean     @default(true)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @default(now()) @updatedAt @map("updated_at")

  responsavel        Responsavel?
  confirmacoesFeitas  Confirmacao[] @relation("ConfirmadoPor")
  conferenciasFinalizadas ConferenciaDia[] @relation("FinalizadoPor")
  conferenciasReabertas   ConferenciaDia[] @relation("ReabertoPor")

  @@map("usuarios")
}

model Responsavel {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId          String?   @unique @map("usuario_id") @db.Uuid
  nome               String    @db.VarChar(255)
  email              String    @unique @db.VarChar(255)
  senhaDistribuicao  String    @map("senha_distribuicao") @db.VarChar(255)
  ativo              Boolean   @default(true)
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  usuario      Usuario?      @relation(fields: [usuarioId], references: [id])
  funcionarios Funcionario[]
  sedes        Sede[]
  alocacoes    Alocacao[]
  pagamentos   Pagamento[]
  comissoesSede           Comissao[] @relation("ComissaoSede")
  comissoesFornecimento   Comissao[] @relation("ComissaoFornecimento")

  @@map("responsaveis")
}

model Funcionario {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  responsavelId  String            @map("responsavel_id") @db.Uuid
  nome           String            @db.VarChar(255)
  telefone       String?           @db.VarChar(50)
  provincia      String?           @db.VarChar(100)
  codigoPostal   String?           @map("codigo_postal") @db.VarChar(20)
  documentoUrl   String?           @map("documento_url")
  status         StatusFuncionario @default(PENDENTE)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at")

  responsavel Responsavel @relation(fields: [responsavelId], references: [id])
  alocacoes   Alocacao[]
  pagamentos  Pagamento[]

  @@index([responsavelId], map: "idx_funcionarios_responsavel")
  @@map("funcionarios")
}

model Sede {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sigla          String    @unique @db.VarChar(50)
  nome           String    @db.VarChar(255)
  endereco       String?
  tipoSede       TipoSede  @map("tipo_sede")
  cluster        String?
  responsavelId  String?   @map("responsavel_id") @db.Uuid
  ativo          Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  responsavel  Responsavel?  @relation(fields: [responsavelId], references: [id])
  modelosVagas ModeloVaga[]
  vagas        Vaga[]
  conferencias ConferenciaDia[]

  @@map("sedes")
}

model ModeloVaga {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sedeId      String         @map("sede_id") @db.Uuid
  nome        String         @db.VarChar(255)
  tipo        TipoModeloVaga
  ativo       Boolean        @default(true)
  observacao  String?
  /// Período de vigência da configuração (docs/features/cadastro-vagas.md, seção 9). Nulo = sem limite naquela ponta.
  dataInicio  DateTime?      @map("data_inicio") @db.Date
  dataFim     DateTime?      @map("data_fim") @db.Date
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at")

  sede  Sede                @relation(fields: [sedeId], references: [id])
  dias  ModeloVagaDia[]
  tipos ModeloVagaTipo[]
  vagas Vaga[]

  @@map("modelos_vagas")
}

model ModeloVagaDia {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modeloVagaId  String @map("modelo_vaga_id") @db.Uuid
  diaSemana     Int    @map("dia_semana")

  modeloVaga ModeloVaga @relation(fields: [modeloVagaId], references: [id], onDelete: Cascade)

  @@map("modelo_vaga_dias")
}

model ModeloVagaTipo {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modeloVagaId    String  @map("modelo_vaga_id") @db.Uuid
  tipoTrabalhoId  String  @map("tipo_trabalho_id") @db.Uuid
  quantidade      Int

  modeloVaga    ModeloVaga    @relation(fields: [modeloVagaId], references: [id], onDelete: Cascade)
  tipoTrabalho  TipoTrabalho  @relation(fields: [tipoTrabalhoId], references: [id])

  @@map("modelo_vaga_tipos")
}

model Vaga {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sedeId        String     @map("sede_id") @db.Uuid
  modeloVagaId  String?    @map("modelo_vaga_id") @db.Uuid
  data          DateTime   @db.Date
  status        StatusVaga @default(ABERTA)
  observacao    String?
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at")

  sede       Sede        @relation(fields: [sedeId], references: [id])
  modeloVaga ModeloVaga? @relation(fields: [modeloVagaId], references: [id])
  tipos      VagaTipo[]
  alocacoes  Alocacao[]

  @@index([data], map: "idx_vagas_data")
  @@index([sedeId], map: "idx_vagas_sede")
  @@map("vagas")
}

model VagaTipo {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vagaId          String  @map("vaga_id") @db.Uuid
  tipoTrabalhoId  String  @map("tipo_trabalho_id") @db.Uuid
  quantidade      Int

  vaga          Vaga          @relation(fields: [vagaId], references: [id], onDelete: Cascade)
  tipoTrabalho  TipoTrabalho  @relation(fields: [tipoTrabalhoId], references: [id])

  @@map("vaga_tipos")
}

model Alocacao {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vagaId          String          @map("vaga_id") @db.Uuid
  funcionarioId   String          @map("funcionario_id") @db.Uuid
  responsavelId   String          @map("responsavel_id") @db.Uuid
  tipoTrabalhoId  String          @map("tipo_trabalho_id") @db.Uuid
  status          StatusAlocacao  @default(ATIVA)
  dataAlocacao    DateTime        @default(now()) @map("data_alocacao")
  observacao      String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at")

  vaga         Vaga         @relation(fields: [vagaId], references: [id])
  funcionario  Funcionario  @relation(fields: [funcionarioId], references: [id])
  responsavel  Responsavel  @relation(fields: [responsavelId], references: [id])
  tipoTrabalho TipoTrabalho @relation(fields: [tipoTrabalhoId], references: [id])
  confirmacao  Confirmacao?
  pagamento    Pagamento?
  comissao     Comissao?

  @@index([funcionarioId], map: "idx_alocacoes_funcionario")
  @@index([vagaId], map: "idx_alocacoes_vaga")
  @@map("alocacoes")
}

model Confirmacao {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  alocacaoId     String             @unique @map("alocacao_id") @db.Uuid
  status         StatusConfirmacao  @default(PENDENTE)
  observacao     String?
  confirmadoPor  String?            @map("confirmado_por") @db.Uuid
  confirmadoEm   DateTime?          @map("confirmado_em")
  createdAt      DateTime           @default(now()) @map("created_at")

  alocacao          Alocacao @relation(fields: [alocacaoId], references: [id])
  confirmadoPorUsuario Usuario? @relation("ConfirmadoPor", fields: [confirmadoPor], references: [id])

  @@map("confirmacoes")
}

/// Trava a conferência de uma sede/dia (docs/features/confirmacao-dia.md,
/// seção 28.1) — quando `finalizadoEm` está preenchido, a tela de
/// Confirmação do Dia bloqueia novas alterações de situação para aquela
/// sede/dia. `reabertoEm`/`reabertoPor` registram a última reabertura (só
/// Administrador), sem apagar o histórico de quem finalizou originalmente.
model ConferenciaDia {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sedeId         String    @map("sede_id") @db.Uuid
  data           DateTime  @db.Date
  finalizadoEm   DateTime? @map("finalizado_em")
  finalizadoPor  String?   @map("finalizado_por") @db.Uuid
  reabertoEm     DateTime? @map("reaberto_em")
  reabertoPor    String?   @map("reaberto_por") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  sede                Sede     @relation(fields: [sedeId], references: [id])
  finalizadoPorUsuario Usuario? @relation("FinalizadoPor", fields: [finalizadoPor], references: [id])
  reabertoPorUsuario   Usuario? @relation("ReabertoPor", fields: [reabertoPor], references: [id])

  @@unique([sedeId, data])
  @@map("conferencias_dia")
}

/// Valor de referência por tipo de trabalho + tipo de sede, com vigência
/// (docs/features/pagamento.md, seções 4/6/7). `valor` = "valor gerado"
/// (o que a sede paga pelo trabalho); `salarioBase` = valor-base do
/// funcionário, só obrigatório para sede EXTERNA — em sede HUB o
/// pagamento ao funcionário é livre (definido na hora de registrar o
/// pagamento), então `salarioBase` fica sempre null.
model TabelaValor {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipoTrabalhoId  String        @map("tipo_trabalho_id") @db.Uuid
  tipoSede        TipoSede      @map("tipo_sede")
  valor           Decimal       @db.Decimal(10, 2)
  salarioBase     Decimal?      @map("salario_base") @db.Decimal(10, 2)
  dataInicio      DateTime?     @map("data_inicio") @db.Date
  dataFim         DateTime?     @map("data_fim") @db.Date
  ativo           Boolean       @default(true)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at")

  tipoTrabalho  TipoTrabalho  @relation(fields: [tipoTrabalhoId], references: [id])

  @@map("tabela_valores")
}

/// Obrigação de pagar o FUNCIONÁRIO por uma alocação confirmada
/// (docs/features/pagamento.md) — `responsavelId` aqui é sempre o dono do
/// funcionário (responsável pelo fornecimento), que é quem paga, mesmo
/// quando a sede pertence a outro responsável (ver seção 15). 1:1 com
/// `Alocacao` via `alocacaoId` único — âncora de idempotência (nunca cria
/// pagamento duplicado pra mesma alocação, seção 29).
///
/// `valorPrevisto` e `valorPago` ficam SEMPRE separados (seção 27/28) —
/// nunca sobrescrever um com o outro. Em sede EXTERNA, `valorPrevisto` já
/// vem preenchido na confirmação (a partir de `TabelaValor.salarioBase`);
/// em sede HUB, fica `null` até o responsável registrar o pagamento
/// (valor livre, seção 7).
model Pagamento {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo           String?          @db.VarChar(100)
  responsavelId  String           @map("responsavel_id") @db.Uuid
  alocacaoId     String           @unique @map("alocacao_id") @db.Uuid
  funcionarioId  String           @map("funcionario_id") @db.Uuid
  valorGerado    Decimal          @map("valor_gerado") @db.Decimal(10, 2)
  valorPrevisto  Decimal?         @map("valor_previsto") @db.Decimal(10, 2)
  valorPago      Decimal?         @map("valor_pago") @db.Decimal(10, 2)
  comprovanteUrl String?          @map("comprovante_url")
  dataPrevista   DateTime?        @map("data_prevista") @db.Date
  dataPagamento  DateTime?        @map("data_pagamento") @db.Date
  status         StatusPagamento  @default(PENDENTE)
  statusPrazo    String?          @map("status_prazo") @db.VarChar(50)
  observacao     String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at")

  responsavel  Responsavel  @relation(fields: [responsavelId], references: [id])
  alocacao     Alocacao     @relation(fields: [alocacaoId], references: [id])
  funcionario  Funcionario  @relation(fields: [funcionarioId], references: [id])

  @@index([status], map: "idx_pagamentos_status")
  @@map("pagamentos")
}

/// Split de comissão entre dono da sede e dono do funcionário, quando são
/// responsáveis diferentes (docs/features/pagamento.md, seções 8-14). 1:1
/// com `Alocacao`, mesma âncora de idempotência que `Pagamento`. Sem
/// status próprio — "recebido ou não" deriva do `Pagamento` ligado à
/// mesma `alocacaoId` (decisão: comissão é só projetada, não tem fluxo de
/// registro próprio). Calculada uma única vez a partir de
/// `Pagamento.valorPrevisto` (congelada — nunca recalcula se
/// `valorPago` divergir depois). Quando o mesmo responsável é dono da
/// sede e do funcionário, todo o resultado fica na perna de fornecimento
/// (`valorComissaoSede = 0`) — evita contar em dobro ao somar "minha
/// comissão" por qualquer uma das duas FKs. `valorComissaoFornecimento`
/// pode ser NEGATIVO (seção 13/14 — dono do funcionário pode ficar
/// devendo os ¥1.000 do dono da sede).
model Comissao {
  id                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  alocacaoId                  String    @unique @map("alocacao_id") @db.Uuid
  valorGerado                 Decimal   @map("valor_gerado") @db.Decimal(10, 2)
  valorFuncionario             Decimal?  @map("valor_funcionario") @db.Decimal(10, 2)
  resultadoCalculado           Decimal?  @map("resultado_calculado") @db.Decimal(10, 2)
  responsavelSedeId           String    @map("responsavel_sede_id") @db.Uuid
  valorComissaoSede            Decimal?  @map("valor_comissao_sede") @db.Decimal(10, 2)
  statusSede                   StatusComissao @default(PENDENTE) @map("status_sede")
  recebidoSedeEm                DateTime? @map("recebido_sede_em")
  responsavelFornecimentoId   String    @map("responsavel_fornecimento_id") @db.Uuid
  valorComissaoFornecimento    Decimal?  @map("valor_comissao_fornecimento") @db.Decimal(10, 2)
  statusFornecimento            StatusComissao @default(PENDENTE) @map("status_fornecimento")
  recebidoFornecimentoEm        DateTime? @map("recebido_fornecimento_em")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @default(now()) @updatedAt @map("updated_at")

  alocacao              Alocacao     @relation(fields: [alocacaoId], references: [id])
  responsavelSede        Responsavel @relation("ComissaoSede", fields: [responsavelSedeId], references: [id])
  responsavelFornecimento Responsavel @relation("ComissaoFornecimento", fields: [responsavelFornecimentoId], references: [id])

  @@index([responsavelSedeId], map: "idx_comissoes_responsavel_sede")
  @@index([responsavelFornecimentoId], map: "idx_comissoes_responsavel_fornecimento")
  @@map("comissoes")
}
