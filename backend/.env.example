# Porta da API
PORT=3000

# Origem permitida para CORS (URL do frontend)
FRONTEND_URL=http://localhost:4200

# --- Banco de dados (Postgres via Prisma) ---
# String de conexão completa, ex.: postgresql://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=

# --- Login (e-mail + senha, tabela usuarios) ---
# Não são usadas em runtime — o Administrador vira uma linha em `usuarios`
# (tipo=ADMIN) via seed. Essas variáveis só alimentam `prisma/seed.ts` na
# primeira vez que o banco é criado.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Segredo usado para assinar o JWT de sessão emitido pelo backend após o login
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- Comprovante de pagamento (upload pro Google Drive via Service Account) ---
# Chave JSON da service account (Google Cloud, com a Drive API habilitada),
# em uma linha só — como o conteúdo do arquivo baixado do Cloud Console
# (JSON puro) ou o mesmo conteúdo em base64, tanto faz, o backend detecta.
# Nunca commitar a chave de verdade — só o nome da variável fica aqui.
GOOGLE_SERVICE_ACCOUNT_KEY=
# ID da pasta do Google Drive (compartilhada com o e-mail da service
# account, papel "Editor") onde os comprovantes são enviados — é o trecho
# depois de /folders/ na URL da pasta.
GOOGLE_DRIVE_FOLDER_ID=
