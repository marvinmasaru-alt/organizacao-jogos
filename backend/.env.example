# Porta da API
PORT=3000

# Origem permitida para CORS (URL do frontend)
FRONTEND_URL=http://localhost:4200

# --- Google Sheets (Service Account) ---
# ID da planilha (parte da URL entre /d/ e /edit)
GOOGLE_SHEETS_SPREADSHEET_ID=

# Credenciais da Service Account. Em produção, prefira colar o JSON inteiro
# (minificado) numa única variável de secret do provedor de hospedagem, em
# vez de manter o arquivo .json no disco.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Login (e-mail + senha, aba RESPONSAVEIS) ---
# Credenciais do administrador — único usuário fora da aba RESPONSAVEIS
# (os outros 7 são resolvidos pelas colunas Email/Senha dessa aba).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Segredo usado para assinar o JWT de sessão emitido pelo backend após o login
JWT_SECRET=
JWT_EXPIRES_IN=8h
